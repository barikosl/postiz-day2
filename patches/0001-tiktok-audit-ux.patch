+// Reads the duration of the selected video (uploads are same-origin) so we can
+// compare it with max_video_post_duration_sec from creator_info.
+const useVideoDuration = (path?: string) => {
+  const [duration, setDuration] = useState<number | undefined>(undefined);
+  useEffect(() => {
+    setDuration(undefined);
+    if (!path || typeof document === 'undefined') return;
+    const video = document.createElement('video');
+    video.preload = 'metadata';
+    video.onloadedmetadata = () => {
+      if (Number.isFinite(video.duration)) setDuration(video.duration);
+    };
+    video.src = path;
+    return () => {
+      video.onloadedmetadata = null;
+      video.removeAttribute('src');
+      video.load();
+    };
+  }, [path]);
+  return duration;
+};
 
